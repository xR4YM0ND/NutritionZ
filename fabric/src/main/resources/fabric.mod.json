{
  "schemaVersion": 1,
  "id": "nutritionz",
  "version": "${version}",
  "name": "NutritionZ",
  "description": "This mod is about nutritions",
  "authors": [
    "Globox_Z",
    "xR4YM0ND"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/nutritionz",
    "sources": "https://github.com/xR4YM0ND/NutritionZ",
    "issues": "https://github.com/xR4YM0ND/NutritionZ/issues"
  },
  "license": "MIT",
  "icon": "assets/nutritionz/icon.png",
  "environment": "*",
  "entrypoints": {
